# Copy to .env and fill in. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown). All settings: src/rag_eval_platform/config/settings.py
# RAG_CHUNK_STRATEGY=recursive
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# RAG_EMBEDDING_PROVIDER=sentence_transformers   # or openai (then set RAG_EMBEDDING_MODEL=text-embedding-3-small)
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_RAW_DATA_DIR=data/raw
# RAG_VECTOR_STORE=chroma
# RAG_CHROMA_HOST=localhost
# RAG_CHROMA_PORT=8001
# RAG_TOP_K=5
# RAG_RERANK=false
# RAG_LLM_PROVIDER=ollama            # local model via Ollama (no key); or openai
# RAG_LLM_MODEL=qwen3:8b             # any model pulled with `ollama pull`
# RAG_OLLAMA_BASE_URL=http://localhost:11434/v1
# RAG_LLM_TEMPERATURE=0.0
# RAG_LLM_DETAILED_MAX_TOKENS=2048   # length limit for the playground's detailed answer style
# RAG_LLM_REASONING_EFFORT=none      # none = no hidden "thinking" (fast); low/medium/high; default = don't send
# RAG_JUDGE_PROVIDER=ollama          # LLM judge for generation evaluation; or openai
# RAG_JUDGE_MODEL=gemma3:12b         # must differ from RAG_LLM_MODEL; changing it means re-baselining
# RAG_JUDGE_TEMPERATURE=0.0
# RAG_JUDGE_MAX_TOKENS=4096
# RAG_JUDGE_TIMEOUT_SECONDS=300
# RAG_MIN_FAITHFULNESS=0.85
# RAG_MIN_ANSWER_RELEVANCE=0.80
# RAG_GATE_MAX_DROP=0.02             # gate: max drop of a retrieval metric below baselines/retrieval.json
# RAG_API_HOST=127.0.0.1
# RAG_API_PORT=8000
# RAG_API_KEY=                       # set to require the X-API-Key header; empty = off
# RAG_API_RATE_LIMIT=30              # requests per minute per client
# RAG_LOG_LEVEL=INFO
# RAG_OBSERVE_ENABLED=true            # store every answer, rating and evaluation run
# RAG_OBSERVE_DB=data/observability/rag.db
# RAG_OBSERVE_READONLY_DBS=["data/observability/rag-api.db"]   # other logs the tab shows read-only (JSON list)
# RAG_OBSERVE_STORE_TEXT=true         # false: keep only a hash of the question
# RAG_PRICE_INPUT_PER_1M=0            # USD per 1M input tokens (0 for local Ollama)
# RAG_PRICE_OUTPUT_PER_1M=0
# RAG_DRIFT_WINDOW=20                 # drift: last N answers vs the N before
# RAG_DRIFT_LATENCY_RISE=0.5
# RAG_DRIFT_ERROR_RISE=0.10
# RAG_DRIFT_REFUSAL_RISE=0.15
# RAG_DRIFT_CITATION_RISE=0.10
# RAG_DRIFT_DOWNVOTE_RISE=0.20
# RAG_REVIEW_SLOW_MS=30000
